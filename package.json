{
  "name": "tsukimichi-extensions",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "compile": "turbo run compile",
    "lint": "turbo run lint",
    "format": "turbo run lint",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "changeset": "changeset",
    "publish:packages": "changeset publish",
    "version:packages": "turbo build && changeset version",
    "gen-extension-meta:anime": "cross-env EXTENSION_TYPE=anime node scripts/generate-extension-meta.js",
    "gen-extension-meta:manga": "cross-env EXTENSION_TYPE=manga node scripts/generate-extension-meta.js",
    "gen-extension-meta:all": "cross-env EXTENSION_TYPE=all node scripts/generate-extension-meta.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.0",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@tsukimichi-extensions/tsconfig": "workspace:*",
    "cross-env": "^10.1.0",
    "turbo": "^2.4.2",
    "typescript": "5.7.3",
    "ultracite": "7.2.3"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  }
}
